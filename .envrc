# gh de este repo usa la cuenta personal (jaimehenao8126), separada de la sesión de trabajo.
# La primera vez: `GH_CONFIG_DIR=$HOME/.config/gh-self-tesla gh auth login` estando en esta carpeta.
export GH_CONFIG_DIR="$HOME/.config/gh-self-tesla"

# Carga variables locales si existen. Los secretos van en .env.local, nunca aquí.
if [ -f .env.local ]; then dotenv .env.local; fi
